# ==========================================
# FoxEats Backend Environment Variables
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL with Drizzle ORM)
DATABASE_URL=postgresql://foxeats:foxeats_password@localhost:5432/foxeats_db

# Auth & Security Configuration (Better Auth)
BETTER_AUTH_SECRET=foxeats_super_secret_jwt_key_change_in_production
BETTER_AUTH_URL=http://localhost:3001

# White-Label Restaurant Identity
STORE_ID=store_001_default
STORE_NAME="FoxEats Restaurant"
STORE_BRAND_COLOR="#D9A441"

# Business Intelligence (BI) Outbound Sync Engine
BI_SYNC_ENABLED=true
BI_SERVER_URL=https://bi-central.foxeats.com/api/v1/ingest
BI_SERVER_API_KEY=fe_bi_live_key_replace_me
BI_SYNC_CRON="0 1 * * *"  # Daily at 01:00 AM local time

# Ticketeras (ESC/POS LAN): modo, IP y puerto se guardan en la tabla `ticketera`
# y se editan desde Administración → Ticketeras.

